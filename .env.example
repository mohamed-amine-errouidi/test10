# ── Copier ce fichier en .env et remplir les valeurs ──

# Base de données
DATABASE_URL=sqlite:///datapulse.db
# PostgreSQL (production Render):
# DATABASE_URL=postgresql://user:password@host:5432/datapulse

# Securite — OBLIGATOIRE en production
SECRET_KEY=change-this-in-production-use-secrets-token-hex

# SendGrid — pour envoi des codes de connexion
# 1. Creer un compte sur sendgrid.com (gratuit)
# 2. Settings > API Keys > Create API Key
# 3. Coller la cle ci-dessous
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email expediteur (doit etre verifie dans SendGrid)
SENDGRID_FROM_EMAIL=noreply@votredomaine.com
